<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_version_view_form" model="ir.ui.view">
        <field name="name">project.version.view.form</field>
        <field name="model">project.version</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="edition" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_version_view_tree" model="ir.ui.view">
        <field name="name">project.version.view.tree</field>
        <field name="model">project.version</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name" />
                <field name="edition" />
            </list>
        </field>
    </record>

    <record id="project_version_action" model="ir.actions.act_window">
        <field name="name">Project Version</field>
        <field name="res_model">project.version</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="project_version_menu"
        name="Project Version"
        action="project_ucs.project_version_action"
        parent="project.menu_project_config"
        sequence="10"/>

</odoo>
